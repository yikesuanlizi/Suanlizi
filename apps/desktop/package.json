{
  "name": "@suanlizi/desktop",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev:ui": "vite --host 127.0.0.1 --port 5178",
    "build:ui": "tsc -b && vite build",
    "preview:ui": "vite preview --host 127.0.0.1 --port 5178",
    "dev": "npm run electron:dev",
    "build": "npm run build:ui && npm run electron:build && npm run electron:package",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:package": "electron-builder --config electron-builder.yml",
    "electron:dev": "npm run electron:build && electron dist-electron/main/index.js"
  },
  "dependencies": {
    "@suanlizi/browser-runtime": "1.8.0",
    "@suanlizi/protocol": "1.8.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tencent-weixin/openclaw-weixin": "^2.4.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "^26.15.3"
  }
}
